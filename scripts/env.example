# Environment Configuration for Seal Builds
# Copy this file to ~/.seal/seal.env and adjust values

# Keystore Configuration
export KEYSTORE_PATH="$HOME/.seal/keystore.jks"
export KEYSTORE_PASSWORD="your_keystore_password"
export KEY_ALIAS="github"
export KEY_PASSWORD="$KEYSTORE_PASSWORD"

# GitHub Token (with repo scope for creating releases)
export GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google Play Service Account (optional - for Play Store deployment)
# Base64-encoded JSON key from Google Cloud Console
export PLAY_STORE_JSON_KEY="eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6Ij... (truncated)"

# Android SDK/NDK paths
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/25.2.9519653"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools"

# Gradle configuration (optional)
export GRADLE_OPTS="-Xmx4g -Dorg.gradle.daemon=false"
